{
  "name": "imrdatabase",
  "compatibility_date": "2026-10-01",
  // Worker handles /api/* (Bracket Challenge); everything else is the static site in ./dist
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imrdatabase-bracket",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
